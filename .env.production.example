# =============================================================================
# PERJODA — production environment template for Coolify.
#
# Copy these keys into the Coolify application's "Environment Variables" screen.
# DO NOT commit real values. DO NOT create a real .env.production in the repo
# (it is git-ignored on purpose). The container reads these from the
# environment; no .env file is shipped in the image.
# =============================================================================

APP_NAME="PERJODA Transport Cooperative"
APP_ENV=production
APP_DEBUG=false
# Generate once locally:  php artisan key:generate --show
APP_KEY=
# Set to the URL Coolify serves the app on (the generated *.sslip.io URL, or
# http://187.53.133.215:PORT while testing). Update when a domain is added.
APP_URL=https://CHANGE-ME

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# --- Database: a SEPARATE Coolify MySQL resource on the internal network ---
DB_CONNECTION=mysql
DB_HOST=CHANGE-ME            # Coolify DB service hostname (internal), e.g. mysql-xxxxxxxx
DB_PORT=3306
DB_DATABASE=perjoda
DB_USERNAME=perjoda
DB_PASSWORD=CHANGE-ME        # from the Coolify database resource

# --- Sessions / cache / queue (all DB-backed; tables are migrated) --------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# Sanctum admin auth uses bearer tokens (not cookies); keep the host in sync
# with APP_URL if you later use stateful/cookie auth.
SANCTUM_STATEFUL_DOMAINS=CHANGE-ME

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# --- Mail: contact-form notifications. Defaults to log (no delivery). -----
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@perjoda.example"
MAIL_FROM_NAME="${APP_NAME}"

# --- Deploy helpers (read by docker/entrypoint.sh) ----------------------
# Set true for the FIRST deploy only to seed the admin user + starter content,
# then delete it. Seeding is additive, never destructive.
DB_SEED_ON_DEPLOY=false

# First admin account (used only when DB_SEED_ON_DEPLOY=true). Change the
# password immediately after first login.
ADMIN_NAME="PERJODA Administrator"
ADMIN_EMAIL=admin@perjoda.example
ADMIN_PASSWORD=CHANGE-ME
