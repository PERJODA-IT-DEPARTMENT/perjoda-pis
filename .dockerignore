# Keep the build context small and never ship secrets or host artifacts.

# VCS / editors / tooling
.git
.gitattributes
.gitignore
.github
.claude
.idea
.vscode
.zed
.nova
.phpactor.json
.phpunit.cache
.phpunit.result.cache
_ide_helper.php

# Dependencies / build output — rebuilt inside the image
node_modules
vendor
public/build
public/hot
public/storage

# Local runtime state
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/pail
database/database.sqlite

# Secrets — never copy any real .env into the image
.env
.env.*
!.env.example
!.env.production.example

# Local-only compose + docs
docker-compose.yml
docker-compose.override.yml
README.md
CLAUDE.md
AGENTS.md
tests
phpunit.xml
.editorconfig
